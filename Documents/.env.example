# ---------------------------------------------------------------------------
# AI Instagram Analytics Platform - environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env
#
# Variables marked REQUIRED have no default - the app will not start without
# them. Everything else falls back to the value shown.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Instagram AI Agent           # REQUIRED
APP_VERSION=1.0.0                     # REQUIRED

# development | staging | production
# Setting this to `production` enables stricter startup validation: DEBUG must
# be false, JWT_SECRET_KEY must be >=32 chars, and CORS_ALLOWED_ORIGINS must
# not contain "*". It also disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development
DEBUG=false

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_ai  # REQUIRED

# Echo every SQL statement to the log. Useful locally, very noisy in prod.
DATABASE_ECHO=false

# Connection pool sizing. POOL_SIZE is the number of persistent connections
# per process; MAX_OVERFLOW is how many extra may be opened under load.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Read by docker-compose.prod.yml to initialize the Postgres container and to
# build the in-network DATABASE_URL for the app/worker services. Not read by
# the application itself - keep in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=instagram_ai

# --- Redis -----------------------------------------------------------------
# Backs the background job queue and the AI response cache.
REDIS_URL=redis://localhost:6379      # REQUIRED

# How long AI-generated insights/recommendations/reports stay cached, per
# user. Lower = fresher data, more Gemini API calls. Default is 15 minutes.
CACHE_TTL_SECONDS=900

# --- Authentication --------------------------------------------------------
# !! The two values below are PUBLIC SAMPLE SECRETS. !!
# They exist so `cp .env.example .env` gives you a working local setup with
# no extra steps. They are committed to source control and therefore known to
# everyone. Setting ENVIRONMENT=production while either is still in place
# will refuse to start.
#
# REQUIRED. Must be >=32 characters in production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this invalidates every issued access token (all users signed out).
JWT_SECRET_KEY=dev-only-276600405983050a586da0a46095b079b27f257678439047e52ff91c

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Encryption ------------------------------------------------------------
# REQUIRED. Encrypts stored Instagram access tokens at rest. Must be a valid
# Fernet key (32 url-safe base64-encoded bytes). Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes existing stored tokens undecryptable - affected users
# must reconnect their Instagram account.
#
# Also a PUBLIC SAMPLE SECRET - see the warning above.
TOKEN_ENCRYPTION_KEY=cX7aqLayA2jfaLdKAvzVWC0TirwwWbcVPkiKTwAkgE4=

# --- Gemini (Google AI Studio) ----------------------------------------------
# Optional. Without it the app runs normally, but /ai/*, /insights,
# /recommendations and /reports/* return 503.
# Free tier - create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2

# Max agent <-> tool round trips per /ai/chat request, guarding against
# runaway tool-calling loops.
AI_RECURSION_LIMIT=8

# --- Instagram / Meta ------------------------------------------------------
# Optional. Without these, /instagram/connect returns 503; everything else
# works. From your Meta app at https://developers.facebook.com/apps
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must exactly match a redirect URI whitelisted in the Meta app settings.
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback

INSTAGRAM_GRAPH_API_VERSION=v21.0

# Unused by the current code paths; reserved for direct Graph API calls.
META_ACCESS_TOKEN=

# --- Security --------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Must not be "*"
# when ENVIRONMENT=production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the Instalysis frontend. The Instagram OAuth callback redirects
# the browser back here when the connection finishes. Must be listed in
# CORS_ALLOWED_ORIGINS above.
FRONTEND_URL=http://localhost:3000

# Rate limits, per client IP. DEFAULT applies to every endpoint; STRICT
# overrides it on AI-backed endpoints (each costs an LLM call); AUTH
# overrides it on login/register to blunt brute-force attempts.
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STRICT=10/minute
RATE_LIMIT_AUTH=5/minute

# --- Logging ---------------------------------------------------------------
# json for machine-parseable production logs, text for readable local ones.
LOG_LEVEL=INFO
LOG_FORMAT=json
